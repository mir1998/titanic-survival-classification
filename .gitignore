__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Virtual environments ---
venv/
.venv/
env/

# --- Jupyter ---
.ipynb_checkpoints/

# --- IDE / OS ---
.vscode/
.idea/
Thumbs.db
desktop.ini
